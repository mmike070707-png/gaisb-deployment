#!/usr/bin/env python3
import os

# Updated coordinates for new device (Master List 8.2)
BUTTON_COORDINATES = {
    "action": (338, 1481),
    "mallet": (527, 1522)
}

def perform_tap(button_name):
    coords = BUTTON_COORDINATES.get(button_name)
    if coords:
        # Executes the ADB tap command
        os.system(f"adb shell input tap {coords[0]} {coords[1]}")
        print(f"Tapped {button_name} at {coords}")

# Execute sequence
perform_tap("action")
perform_tap("mallet")
